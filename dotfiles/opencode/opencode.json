{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "references": {
    "opencode-source": {
      "path": "../../external/opencode",
      "description": "OpenCode source code, docs source, and implementation details"
    },
    "ce-source": {
      "path": "../../external/compound-engineering",
      "description": "Compound Engineering plugin by Every — source code, agents, skills, and docs"
    },
    "heypogi-src-agents": {
      "path": "../../src/agents",
      "description": "Custom agent definitions for heypogi"
    },
    "heypogi-src-skills": {
      "path": "../../src/skills",
      "description": "Custom skill definitions for heypogi"
    },
    "heypogi-src-tools": {
      "path": "../../src/tools",
      "description": "Custom tool definitions for heypogi"
    }
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "../../external/opencode/**": "allow",
      "../../external/compound-engineering/plugins/compound-engineering/**": "allow",
      "~/.agents/skills/**": "allow",
      "~/.local/share/opencode/**": "allow"
    }
  }
}
