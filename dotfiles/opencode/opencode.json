{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "references": {
    "opencode-source": {
      "path": "../../external/opencode",
      "description": "OpenCode source code, docs source, and implementation details"
    },
    "ce-source": {
      "path": "../../external/compound-engineering",
      "description": "Compound Engineering plugin by Every — source code, agents, skills, and docs"
    },
    "heypogi-src-agents": {
      "path": "../../src/agents",
      "description": "Custom agent definitions for heypogi"
    },
    "heypogi-src-skills": {
      "path": "../../src/skills",
      "description": "Custom skill definitions for heypogi"
    },
    "heypogi-src-tools": {
      "path": "../../src/tools",
      "description": "Custom tool definitions for heypogi"
    },
    "heypogi-agents": {
      "path": "agents",
      "description": "Custom OpenCode agent definitions (auto-discovered .md files)"
    },
    "heypogi-commands": {
      "path": "commands",
      "description": "Custom OpenCode slash command definitions (auto-discovered .md files)"
    },
    "heypogi-agents-data": {
      "path": "agents_data",
      "description": "Supporting data files for custom agents (references, scripts)"
    },
    "downloads": {
      "path": "C:/Users/rmicua/Downloads",
      "description": "System downloads directory"
    }
  },
  "agent": {
    "explore": {
      "model": "opencode-go/deepseek-v4-flash"
    }
  },
  "skills": {
    "paths": ["../../src/skills"]
  },
  "permission": {
    "bash": {
      "git *": "allow",
      "rg *": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "more *": "allow",
      "less *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "diff *": "allow",
      "wc *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "which *": "allow",
      "type *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "date *": "allow",
      "whoami": "allow",
      "env": "allow",
      "printenv *": "allow",
      "uname *": "allow",
      "hostname *": "allow",
      "dir *": "allow",
      "tree *": "allow",
      "sort *": "allow",
      "Get-Content *": "allow",
      "Get-ChildItem *": "allow",
      "Test-Path *": "allow",
      "Write-Output *": "allow",
      "Get-Location *": "allow",
      "Select-String *": "allow",
      "Get-Command *": "allow",
      "Get-Item *": "allow",
      "Get-Process *": "allow",
      "Get-Date *": "allow",
      "Resolve-Path *": "allow",
      "Get-ItemProperty *": "allow",
      "Convert-Path *": "allow",
      "Split-Path *": "allow",
      "Join-Path *": "allow"
    },
    "external_directory": {
      "../../external/opencode/**": "allow",
      "../../external/compound-engineering/plugins/compound-engineering/**": "allow",
      "~/.agents/skills/**": "allow",
      "~/.local/share/opencode/**": "allow",
      "~/.config/opencode/**": "allow",
      "C:/Users/rmicua/AppData/Local/Temp/opencode/**": "allow",
      "C:/Users/rmicua/Downloads/**": "allow",
      "~/tmp/**": "allow"
    }
  }
}
