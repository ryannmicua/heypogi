#!/usr/bin/env bash
# gh — shim so EVERY GitHub CLI call on this machine acts as the GitHub App
# identity (<slug>[bot]) instead of requiring a personal login.
#
# Why: tools that exec `gh` by PATH (Paseo daemon + its agents, IDE GitHub
# features) get the bot identity automatically. Installation tokens are
# short-lived (~1h), so they are minted/cached per invocation via
# gh-app-token. Git push/pull attribution continues to flow through
# git-credential-gh-app; nothing here touches git config.
#
# Installation selection (highest wins):
#   1. GH_APP_INSTALLATION env var        (per-command or per-repo export)
#   2. org in a command-line arg (e.g. `gh repo view ORG/repo`), if it
#      matches a named installation
#   3. org of the current repo's origin remote (covers commands like
#      `gh pr view` that infer the repo from the working directory)
#   4. first installation listed in app.conf
#
# Escape hatch: export GH_TOKEN or GITHUB_TOKEN yourself and this shim runs
# the real gh untouched. Degrades gracefully: with no app.conf/token yet,
# plain unauthenticated gh behavior is preserved.
#
# __GH_BIN__ is resolved at install time by github-app-identity.sh.
# Installed to: ~/.local/bin/gh (must precede the real gh on PATH)
# Canonical copy: heypogi repo tooling/machine/gh.shim.template
set -euo pipefail

REAL_GH="__GH_BIN__"

if [[ -z "${GH_TOKEN:-}" && -z "${GITHUB_TOKEN:-}" ]]; then
  name=${GH_APP_INSTALLATION:-}
  conf="$HOME/.config/github-app/app.conf"
  if [[ -f "$conf" ]]; then
    if [[ -z "$name" ]]; then
      for a in "$@"; do
        while [[ "$a" == /* ]]; do a=${a#/}; done   # gh api /repos/ORG/x
        case "$a" in -*|*=*) continue ;; esac       # skip flags and --flag=value
        [[ "$a" == */* ]] || continue
        cand=${a%%/*}
        ecand=$(printf '%s' "$cand" | sed 's/[.[\*^$()+?{|]/\\&/g')
        if grep -qE "^${ecand}=" "$conf"; then name=$cand; break; fi
        # Try second segment for gh api repos/ORG/REPO style routes
        rest=${a#*/}
        if [[ "$rest" == */* ]]; then
          cand=${rest%%/*}
          ecand=$(printf '%s' "$cand" | sed 's/[.[\*^$()+?{|]/\\&/g')
          if grep -qE "^${ecand}=" "$conf"; then name=$cand; break; fi
        fi
      done
    fi
    # No org on the command line: infer from the current repo's origin
    # remote so directory-scoped commands (gh pr view/list, run watch...)
    # pick the installation that actually owns the repo.
    if [[ -z "$name" ]]; then
      url=$(git remote get-url origin 2>/dev/null) || url=""
      if [[ -n "$url" ]]; then
        case "$url" in
          git@github.com:*)                         path=${url#git@github.com:} ;;
          ssh://git@github.com/*)                   path=${url#ssh://git@github.com/} ;;
          http://github.com/*|https://github.com/*) path=${url#*://github.com/} ;;
          *)                                        path="" ;;
        esac
        path=${path%.git}
        cand=${path%%/*}
        if [[ -n "$cand" && "$cand" != "$path" ]]; then
          ecand=$(printf '%s' "$cand" | sed 's/[.[\*^$()+?{|]/\\&/g')
          if grep -qE "^${ecand}=" "$conf"; then name=$cand; fi
        fi
      fi
    fi
    if [[ -z "$name" ]]; then
      name=$(grep -vE '^\s*#|^\s*$|GITHUB_APP_' "$conf" | head -1 | cut -d= -f1)
    fi
    if [[ -n "$name" ]] && token=$("$HOME/.local/bin/gh-app-token" "$name" 2>/dev/null); then
      export GH_TOKEN="$token"
    fi
  fi
fi

exec "$REAL_GH" "$@"
