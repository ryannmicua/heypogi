#!/usr/bin/env bash
# git-credential-gh-app — git credential helper backed by gh-app-token.
# Serves https://github.com only; wired for that host by the installer:
#   git config --global credential.https://github.com.helper \
#     '!<HOME>/.local/bin/git-credential-gh-app'
#
# Installation selection (highest wins):
#   1. GH_APP_INSTALLATION env var        (per-command or per-repo export)
#   2. org name in the request path, if it matches a named installation
#      (requires credential.https://github.com.useHttpPath true)
#   3. first installation listed in app.conf
set -euo pipefail

CONF_FILE="$HOME/.config/github-app/app.conf"

input=$(cat)
[[ "$input" == *protocol=https* ]] || exit 0
case "$input" in *host=github.com*) ;; *) exit 0;; esac

name=${GH_APP_INSTALLATION:-}
if [[ -z "$name" ]]; then
  path_line=$(printf '%s\n' "$input" | grep '^path=' || true)
  p=${path_line#path=}; p=${p#/}
  org=${p%%/*}
  if [[ -n "$org" && -f "$CONF_FILE" ]] && grep -qE "^${org}=" "$CONF_FILE"; then
    name=$org
  fi
fi
if [[ -z "$name" && -f "$CONF_FILE" ]]; then
  name=$(grep -vE '^\s*#|^\s*$|GITHUB_APP_' "$CONF_FILE" | head -1 | cut -d= -f1)
fi
[[ -n "$name" ]] || exit 1

token=$("$HOME/.local/bin/gh-app-token" "$name" 2>/dev/null) || exit 1
printf 'username=x-access-token\npassword=%s\n' "$token"
