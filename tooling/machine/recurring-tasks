#!/usr/bin/env bash
# recurring-tasks - Monitor heypogi recurring tasks (read-only)
# Reads tooling/recurring-tasks.json manifest, checks system state
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
MANIFEST="$REPO_DIR/tooling/recurring-tasks.json"

BOLD='\033[1m'
DIM='\033[2m'
GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
CYAN='\033[36m'
RESET='\033[0m'

if [ ! -f "$MANIFEST" ]; then
  echo -e "${RED}ERROR: manifest not found at $MANIFEST${RESET}" >&2
  exit 1
fi

echo -e "${BOLD}Heypogi Recurring Tasks${RESET}  ${DIM}$(date)${RESET}"
echo -e "${DIM}manifest: $MANIFEST${RESET}"
echo ""

# read manifest into shell-friendly format
task_count=$(python3 -c "
import json
with open('$MANIFEST') as f:
    print(len(json.load(f)['tasks']))
")

total=$task_count
active=0
inactive=0
missing=0

for i in $(seq 0 $((task_count - 1))); do
  eval "$(python3 -c "
import json
with open('$MANIFEST') as f:
    t = json.load(f)['tasks'][$i]
print(f\"TYPE=\\\"{t['type']}\\\"\")
print(f\"NAME=\\\"{t['name']}\\\"\")
print(f\"DESC=\\\"{t.get('description', '')}\\\"\")
print(f\"SCRIPT=\\\"{t.get('script', '')}\\\"\")
print(f\"LOG=\\\"{t.get('log', '')}\\\"\")
print(f\"SCHEDULE=\\\"{t.get('schedule', '')}\\\"\")
print(f\"SCHEDULE_HUMAN=\\\"{t.get('schedule_human', '')}\\\"\")
print(f\"INSTALLED_BY=\\\"{t.get('installed_by', '')}\\\"\")
")"

  # determine status
  status="missing"
  status_color="$RED"
  detail=""

  case "$TYPE" in
    cron)
      full_script="$REPO_DIR/$SCRIPT"
      basename_script=$(basename "$SCRIPT")
      # active: an uncommented line contains the script path
      cron_active=$(crontab -l 2>/dev/null | grep -v '^\s*#' | grep -cF "$full_script" || true)
      # inactive: line contains # followed by the script basename (commented command)
      cron_inactive=$(crontab -l 2>/dev/null | grep -c "#.*$basename_script" || true)

      if [ "$cron_active" -gt 0 ]; then
        status="active"
        status_color="$GREEN"
        cron_line=$(crontab -l 2>/dev/null | grep -v '^\s*#' | grep -F "$full_script" | head -1)
        detail=$(echo "$cron_line" | awk '{for(i=1;i<=5;i++) printf "%s ", $i; print ""}' | sed 's/ *$//')
      elif [ "$cron_inactive" -gt 0 ]; then
        status="inactive"
        status_color="$YELLOW"
        detail="(commented out)"
      fi
      ;;
    paseo)
      if command -v paseo &>/dev/null; then
        paseo_output=$(paseo_list_schedules 2>/dev/null) || true
        paseo_status=$(echo "$paseo_output" | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    for s in data:
        if s.get('name') == '$NAME' or '$SCRIPT' in s.get('prompt', ''):
            print(s.get('status', ''))
            break
    else:
        print('')
except:
    print('')
" 2>/dev/null)

        if [ "$paseo_status" = "active" ]; then
          status="active"
          status_color="$GREEN"
          schedule=$(echo "$paseo_output" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for s in data:
    if s.get('name') == '$NAME' or '$SCRIPT' in s.get('prompt', ''):
        print(s.get('cadence', {}).get('expression', '?'))
        break
" 2>/dev/null)
          detail="$schedule"
        elif [ -n "$paseo_status" ]; then
          # exists but paused
          status="inactive"
          status_color="$YELLOW"
          detail="(status: $paseo_status)"
        fi
      fi
      ;;
  esac

  # log file info
  log_info=""
  if [ -n "$LOG" ]; then
    log_full="$REPO_DIR/$LOG"
    if [ -f "$log_full" ]; then
      log_size=$(du -h "$log_full" 2>/dev/null | cut -f1)
      log_modified=$(stat -c '%Y' "$log_full" 2>/dev/null || echo "0")
      log_age=$(( ($(date +%s) - log_modified) / 86400 ))
      if [ "$log_age" -eq 0 ]; then
        log_age_str="today"
      elif [ "$log_age" -eq 1 ]; then
        log_age_str="yesterday"
      else
        log_age_str="${log_age}d ago"
      fi
      log_info="${DIM}log: $LOG ($log_size, $log_age_str)${RESET}"
    else
      log_info="${DIM}log: $LOG (not yet created)${RESET}"
    fi
  fi

  # print status line
  case "$status" in
    active)
      echo -e "  ${GREEN}ACTIVE${RESET}   ${BOLD}$NAME${RESET}"
      ((active++)) || true
      ;;
    inactive)
      echo -e "  ${YELLOW}INACTIVE${RESET} ${BOLD}$NAME${RESET}"
      ((inactive++)) || true
      ;;
    missing)
      echo -e "  ${RED}MISSING${RESET}  ${BOLD}$NAME${RESET}"
      ((missing++)) || true
      ;;
  esac

  echo -e "           ${DIM}$DESC${RESET}"
  echo -e "           type: $TYPE  schedule: ${SCHEDULE_HUMAN:-$SCHEDULE}  target: $SCRIPT"
  [ -n "$detail" ] && echo -e "           system: $detail"
  [ -n "$log_info" ] && echo -e "           $log_info"
  [ -n "$INSTALLED_BY" ] && echo -e "           installed by: ${DIM}$INSTALLED_BY${RESET}"
  echo ""
done

echo -e "${BOLD}Summary: $total task(s)  ${GREEN}${active} active${RESET}  ${YELLOW}${inactive} inactive${RESET}  ${RED}${missing} missing${RESET}"
echo ""
