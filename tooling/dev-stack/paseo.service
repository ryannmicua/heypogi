# Paseo systemd USER unit template (userspace, no root required).
#
# Install (no sudo):
#   mkdir -p ~/.config/systemd/user
#   sed -e "s|__USER__|$(whoami)|g" -e "s|__HOME__|$HOME|g" \
#     tooling/dev-stack/paseo.service > ~/.config/systemd/user/paseo.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now paseo.service
#
# For the daemon to survive logout, lingering must be enabled (one-time,
# requires sudo):  sudo loginctl enable-linger <user>
#
# Auth password: set PASEO_PASSWORD in ~/.config/heypogi/.env-secrets
# (chmod 600). The unit loads .env-secrets directly — agents need these
# vars at runtime, and the threat model is the model seeing secrets in
# context, not the process having them in env.
[Unit]
Description=Paseo AI Agent Daemon (userspace)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/node-bin/paseo daemon start --listen 0.0.0.0:6767 --web-ui --foreground
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=HOME=%h
Environment=PASEO_HOME=%h/.paseo
EnvironmentFile=-%h/.config/heypogi/.env-common
EnvironmentFile=-%h/.config/heypogi/.env-override
EnvironmentFile=-%h/.config/heypogi/.env-secrets
# PATH last: EnvironmentFile entries override Environment=, and the env files
# are bash-oriented, so force the userspace-first PATH here. NOTE: systemd
# expands %h but NOT $HOME/~ - always use the specifier syntax in units.
# (%h/.local/node-bin is a symlink to the current nvm Node's bin dir.)

Environment=PATH=%h/.local/bin:%h/.local/node-bin:%h/.opencode/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
